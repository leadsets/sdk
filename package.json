{
  "name": "@leadsetsai/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript and JavaScript SDK for the Leadsets B2B data API: people and company search, enrichment, email verification and web scraping.",
  "license": "MIT",
  "author": "Leadsets",
  "homepage": "https://www.leadsets.ai/docs?utm_source=github&utm_medium=readme&utm_campaign=sdk-js&utm_content=package-json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leadsets/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/leadsets/sdk/issues"
  },
  "keywords": [
    "leadsets",
    "b2b-data",
    "lead-generation",
    "people-search",
    "company-search",
    "enrichment",
    "email-verification",
    "web-scraping",
    "sales",
    "api",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
